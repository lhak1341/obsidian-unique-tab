{
  "name": "unique-tab",
  "version": "1.0.3",
  "type": "module",
  "scripts": {
    "build": "esbuild main.ts --bundle --minify --external:obsidian --external:electron --external:@codemirror/state --external:@codemirror/view --outfile=main.js --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "bun run typecheck && bun run build && bun run scripts/deploy.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@typescript-eslint/parser": "^8.67.0",
    "esbuild": "^0.28.2",
    "eslint": "10.8.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.13.1",
    "typescript": "6.0.3"
  }
}
